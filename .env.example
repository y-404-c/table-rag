# 复制为 .env 后填写。环境变量前缀 TR_，嵌套用 __ 分隔。
# 本项目默认全 API 后端：qwen3.8-flash 生成 + text-embedding-v3 向量 + gte-rerank-v2 精排。

TR_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TR_LLM__MODEL=qwen3.8-flash
TR_LLM__API_KEY=sk-xxxx
# 可选：额度耗尽后自动轮换的 key 列表（逗号分隔）。评测长跑必备。
# TR_LLM__API_KEYS=sk-aaa,sk-bbb,sk-ccc

TR_EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TR_EMBEDDING__MODEL=text-embedding-v3
TR_EMBEDDING__API_KEY=sk-xxxx

TR_RERANK__URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
TR_RERANK__MODEL=gte-rerank-v2
TR_RERANK__API_KEY=sk-xxxx

# 缓存 / Checkpointer：backend 可选 sqlite（默认）、redis、memory
TR_CACHE__BACKEND=sqlite
# TR_CACHE__URL=redis://localhost:6379/0

# 受控变量：HyDE 默认关闭，实验中通过 --hyde / TR_RETRIEVAL__HYDE=true 打开
TR_RETRIEVAL__HYDE=false
TR_RETRIEVAL__BM25_TOP_K=20
TR_RETRIEVAL__VECTOR_TOP_K=20
TR_RETRIEVAL__RRF_K=60
TR_RETRIEVAL__FINAL_TOP_K=8
